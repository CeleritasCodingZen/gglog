// ============================================
// GGLOG — Prisma Schema
// "Letterboxd for Games"
// ============================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum Visibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum GameStatus {
  PLAYING
  COMPLETED
  DROPPED
  REPLAYED
}

enum ActivityType {
  LOGGED_GAME
  REVIEWED_GAME
  LIKED_REVIEW
  CREATED_LIST
  FOLLOWED_USER
}

enum NotificationType {
  NEW_FOLLOWER
  REVIEW_LIKED
  REVIEW_COMMENTED
}

// ============================================
// USER
// ============================================

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  profile      Profile?
  logEntries   LogEntry[]
  reviews      Review[]
  lists        List[]
  watchlist    WatchlistItem[]
  reviewLikes  ReviewLike[]
  comments     Comment[]
  activities   Activity[]
  accounts     Account[]
  sessions     Session[]

  // Follow relations (directed graph)
  followers Follow[] @relation("following") // people who follow this user
  following Follow[] @relation("follower")  // people this user follows

  // Notification relations
  notifications     Notification[] @relation("NotificationRecipient")
  sentNotifications Notification[] @relation("NotificationActor")

  // WebSocket authentication tickets
  wsTickets WsTicket[]

  @@index([username])
}

// ============================================
// PROFILE
// ============================================

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// GAME (global entity — never duplicated per user)
// ============================================

model Game {
  id              String    @id @default(cuid())
  igdbId          Int       @unique
  name            String
  slug            String?
  summary         String?
  coverUrl        String?
  backgroundUrl   String?
  releaseDate     DateTime?
  igdbRating      Float?
  igdbRatingCount Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  logEntries    LogEntry[]
  reviews       Review[]
  watchlistItems WatchlistItem[]
  listItems     ListItem[]
  activities    Activity[]
  genres        Genre[]
  platforms     Platform[]

  @@index([name])
  @@index([releaseDate])
}

// ============================================
// GENRE (many-to-many with Game via implicit join)
// ============================================

model Genre {
  id     String @id @default(cuid())
  igdbId Int    @unique
  name   String

  games Game[]
}

// ============================================
// PLATFORM (many-to-many with Game via implicit join)
// ============================================

model Platform {
  id     String @id @default(cuid())
  igdbId Int    @unique
  name   String

  games Game[]
}

// ============================================
// LOG ENTRY
// One occasion where a user played a game.
// Multiple LogEntry records for the same user/game ARE allowed.
// ============================================

model LogEntry {
  id        String      @id @default(cuid())
  userId    String
  gameId    String
  playedAt  DateTime?
  rating    Float?
  liked     Boolean     @default(false)
  replay    Boolean     @default(false)
  status    GameStatus  @default(COMPLETED)
  tags      String[]    @default([])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  review     Review?
  activities Activity[]

  @@index([userId, playedAt])
  @@index([gameId, playedAt])
}

// ============================================
// REVIEW
// Belongs to a specific LogEntry (1:1).
// Review owner must match log owner (enforced in app logic).
// ============================================

model Review {
  id          String     @id @default(cuid())
  userId      String
  gameId      String
  logEntryId  String     @unique
  body        String
  spoiler     Boolean    @default(false)
  visibility  Visibility @default(PUBLIC)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  logEntry   LogEntry     @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  likes         ReviewLike[]
  comments      Comment[]
  activities    Activity[]
  notifications Notification[]
}

// ============================================
// WATCHLIST ITEM
// Composite PK — a user cannot add the same game twice.
// ============================================

model WatchlistItem {
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
}

// ============================================
// LIST
// ============================================

model List {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  visibility  Visibility @default(PUBLIC)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      ListItem[]
  activities Activity[]
}

// ============================================
// LIST ITEM
// Composite PK — no duplicate game in a list.
// Position supports manually ordered lists.
// ============================================

model ListItem {
  listId    String
  gameId    String
  position  Int
  createdAt DateTime @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([listId, gameId])
  @@index([listId, position])
}

// ============================================
// FOLLOW (directed relationship)
// A → B does NOT mean B → A.
// Self-follow prevented in application logic.
// ============================================

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ============================================
// REVIEW LIKE
// Composite PK prevents duplicate likes.
// ============================================

model ReviewLike {
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
  @@index([reviewId])
}

// ============================================
// COMMENT
// ============================================

model Comment {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  review        Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([reviewId, createdAt])
}

// ============================================
// ACTIVITY (social events)
// Nullable FKs because different types reference different resources.
// ============================================

model Activity {
  id         String       @id @default(cuid())
  actorId    String
  type       ActivityType
  gameId     String?
  logEntryId String?
  reviewId   String?
  listId     String?
  createdAt  DateTime     @default(now())

  actor    User      @relation(fields: [actorId], references: [id], onDelete: Cascade)
  game     Game?     @relation(fields: [gameId], references: [id], onDelete: SetNull)
  logEntry LogEntry? @relation(fields: [logEntryId], references: [id], onDelete: SetNull)
  review   Review?   @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  list     List?     @relation(fields: [listId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ============================================
// NOTIFICATION
// Lightweight event record for in-app alerts.
// Immutable after creation.
// ============================================

model Notification {
  id        String           @id @default(cuid())
  userId    String           // recipient
  actorId   String           // who triggered it
  type      NotificationType
  reviewId  String?
  commentId String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user    User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  review  Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, read])
  @@index([createdAt])
}

// ============================================
// ACCOUNT (OAuth support)
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ============================================
// SESSION
// ============================================

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// WS TICKET (short-lived WebSocket auth)
// ============================================

model WsTicket {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}